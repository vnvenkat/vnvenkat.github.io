{{ $pages := .Pages.ByDate.Reverse }}

{{ $currentYear := "" }}
{{ $count := len $pages }}
{{ $n := $count }}

<div class="view-citation">

  {{ range $pages }}

    {{ $year := .Date.Format "2006" }}

    {{ if ne $year $currentYear }}

      {{ if ne $currentYear "" }}
        </div>
      {{ end }}

      <h2 class="mt-5 mb-3">{{ $year }}</h2>
      <div>

      {{ $currentYear = $year }}

    {{ end }}

    <div class="pub-list-item" style="margin-bottom: 1.5rem;">

      <span style="font-weight:600; margin-right:0.75rem;">
        [{{ $n }}]
      </span>

      <a href="{{ .RelPermalink }}">
        {{ .Title }}
      </a>

      {{ with .Params.authors }}
        <div class="pub-authors">
          {{ delimit . ", " }}
        </div>
      {{ end }}

      {{ with .Params.publication }}
        <div class="pub-publication">
          {{ . | markdownify }}
        </div>
      {{ end }}

    </div>

    {{ $n = sub $n 1 }}

  {{ end }}

</div>
